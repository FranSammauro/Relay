DATABASE_URL=postgres://queue:queue@localhost:5432/queue
REDIS_URL=redis://localhost:6379
API_ADDR=0.0.0.0:8080
WORKER_ID=worker-local-1
POLL_INTERVAL_MS=500
CONCURRENCY=4
HEARTBEAT_INTERVAL_MS=5000
REAPER_INTERVAL_MS=15000
SCHEDULER_INTERVAL_MS=10000
SHUTDOWN_GRACE_SECONDS=30
RUST_LOG=info

# Rate limiting (por rol, requests por minuto; 0 = sin límite)
RATE_LIMIT_PRODUCER_PER_MINUTE=300
RATE_LIMIT_WORKER_PER_MINUTE=300
RATE_LIMIT_ADMIN_PER_MINUTE=0
